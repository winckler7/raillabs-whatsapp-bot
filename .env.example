# Agendado autónomo (v3): cuenta de servicio de Google Calendar compartida
# con el calendario de Jorge, y su número de WhatsApp para las notificaciones
# de cada cita nueva.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","...":"..."}
GOOGLE_CALENDAR_ID=jorge@gmail.com
OWNER_WHATSAPP_NUMBER=52XXXXXXXXXX

# Confirmación al cliente y aviso a Jorge por correo cuando se agenda una
# cita (vía Resend, con el dominio ya verificado en la cuenta de Resend).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=RailLabs <citas@tudominio.com>
OWNER_EMAIL=jorge@gmail.com

# Demo inmobiliario temporal (ver sales_agent/perfil.py): con
